# ====================================================================
# BOCARDO RESTAURANT - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ====================================================================

# 1. Supabase API Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
SUPABASE_SECRET_KEY=your_service_role_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# 2. Direct Postgres Database Parameters
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here

# 3. Connection Pooler URLs (Remember to URL-encode special chars in password, e.g. @ -> %40)
# Transaction mode pooler (IPv4-only with PgBouncer) - For App Queries
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session mode pooler - For Migrations, DDL, Drizzle, Prisma
DIRECT_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 4. ORM Configurations
DRIZZLE_DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
PRISMA_DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
PRISMA_DIRECT_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
